rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Properties & Land Plots (Parcelles)
    match /properties/{propertyId} {
      allow read, write: if true;
    }
    
    // Leads & Visit Requests
    match /leads/{leadId} {
      allow read, write: if true;
    }
    
    // Tenants (Locataires)
    match /tenants/{tenantId} {
      allow read, write: if true;
    }
    
    // Rent Receipts & Payments (Quittances de location)
    match /receipts/{receiptId} {
      allow read, write: if true;
    }

    // Property Sales Receipts (Reçus de vente de parcelles/biens)
    match /sales/{saleId} {
      allow read, write: if true;
    }

    // Landlords & Property Owners (Bailleurs)
    match /owners/{ownerId} {
      allow read, write: if true;
    }

    // Owner Payouts (Reversements)
    match /payouts/{payoutId} {
      allow read, write: if true;
    }

    // Contracts & Leases (Baux & Mandats)
    match /contracts/{contractId} {
      allow read, write: if true;
    }

    // Agency Expenses & Accounting (Dépenses)
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Agency Configuration & Branding
    match /agency_config/{configId} {
      allow read, write: if true;
    }
    
    // Land Plot Lotissements & Cadastral
    match /lotissements/{lotissementId} {
      allow read, write: if true;
    }

    // Agency Users & RBAC Collaborators
    match /agency_users/{userId} {
      allow read, write: if true;
    }

    // System Health & Connection Test
    match /_system_health/{checkId} {
      allow read, write: if true;
    }
  }
}

